# ==============================================================================
# JARVIS-X Server-Only Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# Do NOT prefix privileged secrets (such as SUPABASE_SERVICE_ROLE_KEY) with NEXT_PUBLIC_.
# Privileged credentials are read exclusively on the server side (`import 'server-only'`).
# ==============================================================================

# --- Supabase Data & Auth Layer ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional Server-Only AI Model Providers (UNCONFIGURED when absent; FoundationLocalProvider runs zero-cost out-of-the-box) ---
# NEVER prefix provider API keys with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
COMPATIBLE_OPENAI_BASE_URL=
COMPATIBLE_OPENAI_API_KEY=
COMPATIBLE_OPENAI_MODEL_ID=

# --- Optional Voice & Multimodal Providers (Future-Ready Interfaces) ---
SPEECH_STT_PROVIDER_URL=
SPEECH_TTS_PROVIDER_URL=
VISION_PROVIDER_MODEL=

# --- Security / Step-Up Authorization Passcode for Tier-3 Sensitive Operations ---
JARVIS_STEP_UP_PASSCODE=JARVIS-VERIFY
